FROM python:3.10-slim

WORKDIR /app

# Copy only requirements first to leverage Docker cache
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Set environment variables
ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8000

# Expose the port
EXPOSE 8000

# Run the application (this will be executed when the container starts)
CMD ["sh", "-c", "cd /app && uvicorn src.api.main:app --host 0.0.0.0 --port 8000"]