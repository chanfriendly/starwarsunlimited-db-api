# Star Wars Unlimited - Environment Configuration Template
# Copy this file to .env for development or .env.prod for production

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Production server details
SERVER_IP=192.168.1.124
FRONTEND_PORT=4000
BACKEND_PORT=8000

# Production volume paths (adjust for your server)
PRODUCTION_DATABASE_PATH=/mnt/volume1/docker/twinsuns/databases

# =============================================================================
# DEVELOPMENT CONFIGURATION 
# =============================================================================

# Local development paths (usually don't need to change these)
FRONTEND_PATH=./frontend
BACKEND_PATH=./backend
DATABASE_PATH=./databases

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database directory inside containers
DB_DIR=/data/.swu

# Full database URLs (will be auto-generated based on DB_DIR)
DATABASE_URL=sqlite:////data/.swu/swu_app.db
CARD_DATABASE_URL=sqlite:////data/.swu/swu_cards.db

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret - MUST change this for production!
# Generate with: openssl rand -hex 32
JWT_SECRET=development_secret_change_in_production

# Token expiration time in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =============================================================================
# NETWORKING CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated, no spaces)
# Development
CORS_ALLOWED_ORIGINS_DEV=http://localhost:3000,http://localhost:4000,http://localhost:8000

# Production (adjust SERVER_IP as needed)
CORS_ALLOWED_ORIGINS_PROD=http://192.168.1.124:4000

# API URLs
# Development
NEXT_PUBLIC_API_URL_DEV=http://localhost:8000
INTERNAL_API_URL_DEV=http://localhost:8000

# Production
NEXT_PUBLIC_API_URL_PROD=http://192.168.1.124:8000
INTERNAL_API_URL_PROD=http://twinsuns-backend:8000

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode
NODE_ENV=development
LOG_LEVEL=INFO

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Python settings
PYTHONPATH=/app